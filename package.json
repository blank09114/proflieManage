{
    "name": "profliemanage",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "test": "npm run test:format && npm run test:editor && npm run test:services",
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "oxlint",
        "test:format": "node --experimental-strip-types --test tests/sectionFormat.test.ts",
        "test:editor": "node --experimental-strip-types --test tests/editorDirty.test.ts tests/sortLock.test.ts",
        "test:editor:browser": "node tests/editor.browser.mjs",
        "test:security:browser": "node tests/security.browser.mjs",
        "test:services": "vitest run",
        "preview": "vite preview"
    },
    "dependencies": {
        "@dnd-kit/core": "6.3.1",
        "@dnd-kit/sortable": "10.0.0",
        "@dnd-kit/utilities": "3.2.2",
        "@supabase/supabase-js": "2.119.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "oxlint": "^1.90.0",
        "typescript": "~7.0.2",
        "vite": "^8.3.6",
        "vitest": "5.1.0"
    }
}
